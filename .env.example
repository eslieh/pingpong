# =============================================================================
# Frontend (Vercel) — Project Settings → Environment Variables
# =============================================================================
# Full WebSocket URL including path. Use wss:// in production.
NEXT_PUBLIC_WS_URL=wss://ws.example.com/ws

# Local dev only (when NEXT_PUBLIC_WS_URL is unset):
# NEXT_PUBLIC_WS_PORT=8081

# =============================================================================
# Backend (VPS) — copy to .env on the server next to server.js
# =============================================================================
NODE_ENV=production
PORT=8081
HOST=127.0.0.1

# Comma-separated browser origins allowed to open WebSockets.
# Must include your Vercel URL(s). Wildcard subdomains: *.vercel.app
ALLOWED_ORIGINS=https://pingpong.vercel.app,https://your-custom-domain.com

# Set when running behind nginx / a reverse proxy (for logs)
TRUST_PROXY=1
